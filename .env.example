# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SADECE SUNUCU. Asla NEXT_PUBLIC_ ön eki verme, asla client bundle'a girmesin.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

NEXT_PUBLIC_SITE_URL=https://cocuktribunu.org

# Hangi sosyal giriş sağlayıcıları AÇIK? Virgülle ayırın: google,apple
# Supabase tarafında etkinleştirmediğiniz sağlayıcıyı BURAYA YAZMAYIN;
# yazarsanız kullanıcı "provider is not enabled" hatası alır.
# Boş bırakırsanız sosyal giriş düğmeleri hiç görünmez.
NEXT_PUBLIC_OAUTH_PROVIDERS=google,apple

# Banka bilgileri (havale ekranında gösterilir)
NEXT_PUBLIC_BANK_NAME=Ziraat Bankası
NEXT_PUBLIC_BANK_HOLDER=Çocuk Tribünü Derneği
NEXT_PUBLIC_BANK_IBAN=TR00 0000 0000 0000 0000 0000 00

# ── Doğrulama servisi (ct-notify) ────────────────────────────
# TÜM e-posta ve SMS işlemleri buradan gider:
#   · Kayıt sonrası hoş geldiniz e-postası
#   · E-posta doğrulama kodu
#   · Telefon doğrulama SMS'i
#   · Şifre sıfırlama kodu
#   · Sipariş / ödeme / bağış bildirimleri
# Supabase'in kendi e-posta gönderimi DEVRE DIŞIDIR.
# Aynı Docker ağındaysa iç adres kullanın (internete açmanıza gerek yok):
#   NOTIFY_SERVICE_URL=http://ct-notify-notify-1:8080
NOTIFY_SERVICE_URL=https://notify.childrentribune.online

# ct-notify'daki SERVICE_SECRET ile BİREBİR AYNI olmalı
NOTIFY_SERVICE_SECRET=

# Cloudflare Turnstile (imza ve bağış formu bot koruması)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Stripe ödeme ────────────────────────────────────────────
# Gizli anahtar: yalnızca sunucuda okunur
STRIPE_SECRET_KEY=sk_test_...
# Webhook imza anahtarı (Stripe > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# Yayımlanabilir anahtar: tarayıcıda kart alanlarını göstermek için
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Ödeme eşitleme ucu için gizli anahtar (takılan ödemeleri kurtarır)
PAYMENT_RECONCILE_SECRET=uzun-rastgele-bir-deger

# Ödeme eşitleme ucu için gizli anahtar (takılan ödemeleri kurtarır)
PAYMENT_RECONCILE_SECRET=uzun-rastgele-bir-deger

# Ödeme sağlayıcısı: stripe | iyzico | paytr
# Değiştirmek için src/lib/payment/index.ts içindeki listeye uygulamayı ekleyin.
PAYMENT_PROVIDER=stripe

# ── Cloudflare R2 (depolama) ──────────────────────────────────────
# Boş bırakılırsa Supabase Storage kullanılmaya devam eder.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Açık kova — özel alan adıyla sunulur
R2_BUCKET=cocuktribunu
# Kapalı kova — alan adı YOK, yalnızca sunucu erişir
R2_BUCKET_PRIVATE=cocuktribunu-ozel

# Açık kovanın özel alan adı. Boşsa okuma Supabase'den yapılır.
NEXT_PUBLIC_R2_PUBLIC_URL=https://medya.cocuktribunu.com

# ── GEÇİŞ ANAHTARLARI ────────────────────────────────────────────
#
# STORAGE_DUAL_WRITE
#   true  → yeni dosyalar HEM R2'ye HEM Supabase'e yazılır (geçiş dönemi)
#   false → YALNIZCA R2. Supabase'e hiç dokunulmaz.
#
#   Taşıma bitene kadar `true` bırakın: okumayı geri almanız
#   gerekirse dosyalar Supabase'de duruyor olur.
#   Her şey çalışıyorsa `false` yapın — asıl hedef bu.
STORAGE_DUAL_WRITE=true
STORAGE_READ_FROM=supabase

# ⚠️ İKİSİ DE AYNI DEĞERİ ALMALI.
#   STORAGE_READ_FROM        → sunucu (dosya indirme)
#   NEXT_PUBLIC_STORAGE_READ_FROM → tarayıcı (görsel adresleri)
# İkincisi derleme anında gömülür; değiştirince REBUILD gerekir.
NEXT_PUBLIC_STORAGE_READ_FROM=supabase
# Tarayıcı tarafı okuma. `publicStorageUrl` bunu okuyor ve öneksiz
# değişkenler tarayıcıya gitmediği için AYRI tanımlanmak zorunda.
# İkisi her zaman AYNI değeri almalı.
